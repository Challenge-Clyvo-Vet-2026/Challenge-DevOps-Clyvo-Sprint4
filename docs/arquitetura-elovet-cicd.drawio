<mxCell id="l5" value="novo artefato&lt;br&gt;dispara o CD" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0F3D6E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="778" y="300" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="l6" value="deploy automático&lt;br&gt;do .jar" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0F3D6E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="175" height="30" as="geometry"/></mxCell>
<mxCell id="l7" value="JDBC / SSL&lt;br&gt;(variáveis de ambiente)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0F3D6E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1298" y="455" width="170" height="30" as="geometry"/></mxCell>
<mxCell id="l8" value="HTTPS + token JWT" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0F3D6E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="290" width="230" height="30" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b style='font-size:15px'&gt;Fluxo CI/CD (ordem numerada)&lt;/b&gt;&lt;table style='margin-top:8px;font-size:12px;border-spacing:0 3px;'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1.&lt;/b&gt; O desenvolvedor faz commit na branch &lt;i&gt;DevOpsEntrega&lt;/i&gt; do Azure Repos e abre um Pull Request para a &lt;i&gt;main&lt;/i&gt;.&lt;/td&gt;&lt;td style='padding-left:30px'&gt;&lt;b&gt;5.&lt;/b&gt; A geração de um novo artefato dispara automaticamente o pipeline de CD.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2.&lt;/b&gt; O merge na &lt;i&gt;main&lt;/i&gt; dispara automaticamente o pipeline de CI (Azure Pipelines, YAML).&lt;/td&gt;&lt;td style='padding-left:30px'&gt;&lt;b&gt;6.&lt;/b&gt; O CD publica o .jar no Azure Web App, usando credenciais guardadas como variáveis secretas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;3.&lt;/b&gt; O CI compila a API com Gradle (Java 21) e executa os 8 testes automatizados (JUnit + Mockito).&lt;/td&gt;&lt;td style='padding-left:30px'&gt;&lt;b&gt;7.&lt;/b&gt; A API lê e grava os dados no PostgreSQL (PaaS) via JDBC/SSL; o Flyway versiona o schema.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;4.&lt;/b&gt; O CI publica os resultados dos testes e o artefato &lt;i&gt;drop&lt;/i&gt; (elo-vet-api.jar) no Azure DevOps.&lt;/td&gt;&lt;td style='padding-left:30px'&gt;&lt;b&gt;8.&lt;/b&gt; O usuário final acessa a API pela internet (HTTPS) com autenticação JWT.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='margin-top:10px;font-size:12px;color:#4B5563'&gt;&lt;b&gt;Stack:&lt;/b&gt; Java 21 · Spring Boot · Spring Security (JWT) · Spring Data JPA · Flyway · Gradle · JUnit/Mockito · Azure Repos · Azure Pipelines · Azure Boards · Azure App Service (Web App) · Azure Database for PostgreSQL Flexible Server · GitHub&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1700" height="250" as="geometry"/></mxCell>
